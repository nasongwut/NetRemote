# =====================================================================
#  NetRemote (โปรแกรมฝั่งผู้ใช้ / Client) — ไฟล์ตั้งค่า (.env)
#  ค่าในไฟล์นี้มีผลเหนือค่าที่ตั้งในโปรแกรม
#  โปรแกรมค้นหาไฟล์ .env ตามลำดับ:
#    1) ตัวแปร NETREMOTE_ENV   2) ~/.netremote/.env
#    3) โฟลเดอร์เดียวกับโปรแกรม (remote_desktop.py / .exe / โฟลเดอร์ที่วาง .app)
#    4) ไฟล์ที่ฝังมากับโปรแกรมตอน Build (วางไฟล์นี้ไว้ก่อนกด Build)
#  ⚠ ไฟล์ .env มีรหัสลับ — ห้ามอัปโหลดขึ้น GitHub (ตั้ง .gitignore ไว้แล้ว)
# =====================================================================

# ที่อยู่ Relay Server  เช่น  relay.cityart.co.th:5910  หรือ  203.0.113.10:5910
#   ถ้ารัน Relay บน Mac mini ในออฟฟิศ: ใส่ IP ของ Mac mini เช่น 192.168.1.50:5910
# RELAY_ADDR=relay.example.com:5910
RELAY_ADDR=10.0.0.4:5910


# ต้องตรงกับ RELAY_KEY ในไฟล์ relay/.env ของ Relay Server
# RELAY_KEY=ใส่ให้ตรงกับ RELAY_KEY ของ Relay
RELAY_KEY=cta1234

# ---------------- ตัวเลือกเพิ่มเติม (ลบ # ข้างหน้าเพื่อใช้) ----------------
# รหัสผ่านเครื่องนี้ เมื่อให้คนอื่นควบคุม (เว้นไว้ = สุ่ม/ตั้งในโปรแกรม)
# HOST_PASSWORD=
# ถามก่อนรับการเชื่อมต่อ (true/false)
# ASK_BEFORE_ACCEPT=true
# อนุญาตให้ควบคุมเมาส์/คีย์บอร์ด
# ALLOW_CONTROL=true
# อนุญาตให้รับ-ส่งไฟล์
# ALLOW_FILES=true
# ธีม: auto / light / dark
# THEME=auto
# โฟลเดอร์เริ่มต้นฝั่งเครื่องนี้ในหน้ารับ-ส่งไฟล์
# DOWNLOAD_DIR=~/Downloads

# ---------------- เชื่อมต่อตรง (ไม่ผ่าน Server) ----------------
# ลองเชื่อมต่อตรงระหว่างสองเครื่องก่อน ต่อไม่ได้จึงใช้ Server (true/false) — ใส่ค่านี้แล้วผู้ใช้เปลี่ยนในโปรแกรมไม่ได้
# DIRECT_CONNECT=true
# พอร์ตสำหรับเชื่อมต่อตรง (0 = สุ่มทุกครั้ง) — ตั้งพอร์ตคงที่ + Port Forward ที่ Router
#   ถ้าต้องการให้ต่อตรงข้ามอินเทอร์เน็ตได้ด้วย (ปกติต่อตรงได้เฉพาะในวง LAN เดียวกัน)
# DIRECT_PORT=0

# ภาษาของโปรแกรม: en / th (เว้นไว้ = เริ่มต้น English, ผู้ใช้เปลี่ยนเองได้ที่ปุ่ม 🌐 มุมขวาบน)
# LANGUAGE=th

# อัปเดตโปรแกรม: เว้นไว้ = ถามก่อนดาวน์โหลด และถามก่อนติดตั้ง
#   auto = ดาวน์โหลด + ติดตั้ง + เปิดใหม่เองโดยไม่ถาม (เครื่องที่ไม่มีคนเฝ้า)
#   quit = ดาวน์โหลดเองโดยไม่ถาม แล้วติดตั้งตอนปิดโปรแกรม
# AUTO_UPDATE=
