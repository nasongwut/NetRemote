# =====================================================================
#  NetRemote Relay Server — ไฟล์ตั้งค่า (.env)
#  relay_server.py จะอ่านไฟล์นี้อัตโนมัติ (ไฟล์ .env ที่อยู่โฟลเดอร์เดียวกัน)
#  ⚠ ไฟล์ .env มีรหัสลับ — ห้ามอัปโหลดขึ้น GitHub (ตั้ง .gitignore ไว้แล้ว)
# =====================================================================

# พอร์ตที่โปรแกรม NetRemote เชื่อมต่อเข้ามา (ต้องเปิดใน Firewall)
RELAY_PORT=5910

# Relay Key — รหัสสำหรับใช้ Relay (โปรแกรม NetRemote ต้องใส่ RELAY_KEY ให้ตรงกัน)
RELAY_KEY=เปลี่ยนเป็นรหัสยาวๆ-เดายาก

# ไฟล์เก็บ ID ที่ลงทะเบียนแล้ว (กัน ID ซ้ำ/ถูกแอบใช้)
RELAY_STORE=relay_ids.json

# จำนวนเซสชันรีโมทพร้อมกันสูงสุด
RELAY_MAX_SESSIONS=50

# ---------------- หน้าเว็บมอนิเตอร์ ----------------
# พอร์ตหน้ามอนิเตอร์ (0 = ปิด)
RELAY_WEB_PORT=5911
# 127.0.0.1 = เปิดดูได้จากเครื่องนี้เท่านั้น (ปลอดภัย, แนะนำ)
# 0.0.0.0   = เปิดให้เครื่องอื่นดูได้ (ต้องใส่รหัส Admin)
RELAY_WEB_BIND=127.0.0.1
# รหัสเข้าหน้ามอนิเตอร์ (ชื่อผู้ใช้อะไรก็ได้) — เว้นว่าง = ใช้ RELAY_KEY
RELAY_ADMIN_KEY=
