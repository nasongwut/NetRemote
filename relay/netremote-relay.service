[Unit]
Description=NetRemote Relay Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# การตั้งค่าทั้งหมดอ่านจากไฟล์ .env (RELAY_KEY, RELAY_PORT, หน้ามอนิเตอร์ ฯลฯ)
EnvironmentFile=/opt/netremote-relay/.env
# เก็บรายการ ID ไว้ในโฟลเดอร์ข้อมูลของ service
Environment=RELAY_STORE=/var/lib/netremote-relay/relay_ids.json
ExecStart=/usr/bin/python3 /opt/netremote-relay/relay_server.py --env /opt/netremote-relay/.env
Restart=always
RestartSec=3
DynamicUser=yes
StateDirectory=netremote-relay
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
