[Unit]
Description=NetRemote Relay Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# โปรแกรมอ่านไฟล์ .env เอง (หน้าเว็บ "ตั้งค่า Server" แก้ไขไฟล์นี้ได้ แล้วโหลดค่าใหม่/รีสตาร์ตเองได้)
# ติดตั้งครั้งแรก:
#   sudo useradd -r -s /usr/sbin/nologin netremote
#   sudo chown -R netremote:netremote /opt/netremote-relay
User=netremote
Group=netremote
WorkingDirectory=/opt/netremote-relay
ExecStart=/usr/bin/python3 /opt/netremote-relay/relay_server.py --env /opt/netremote-relay/.env
Restart=always
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/opt/netremote-relay

[Install]
WantedBy=multi-user.target
